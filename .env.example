# ENTSO-E API Configuration
# Get your API key from: https://transparency.entsoe.eu/
ENTSOE_API_KEY=your_entsoe_api_key_here
BIDDING_ZONE=AT

# LLM Provider Configuration
# Multiple options supported - choose ONE of the following setups:

# === OPTION 1: Cerebras (Default) ===
# Get your API key from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=your_model_id

# === OPTION 2: Generic OpenAI-Compatible API ===
# Use this for Cerebras, OpenRouter, local LLMs, or other OpenAI-compatible APIs
# LLM_PROVIDER=cerebras                              # Options: cerebras, openai, anthropic, openrouter, custom
# LLM_API_KEY=your_api_key_here                      # Your API key
# LLM_API_BASE=https://api.cerebras.ai              # API base URL
# CEREBRAS_MODEL=your_model_id                       # Model ID to use

# === OPTION 3: OpenAI ===
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_PROVIDER=openai
# LLM_API_BASE=https://api.openai.com
# CEREBRAS_MODEL=your_model_id

# === OPTION 4: OpenRouter (multi-provider aggregator) ===
# OPENAI_API_KEY=your_openrouter_api_key_here
# LLM_PROVIDER=openrouter
# LLM_API_BASE=https://openrouter.ai/api
# CEREBRAS_MODEL=provider/model-name

# === OPTION 5: Local LLM (e.g., Ollama, LM Studio) ===
# LLM_API_KEY=not_required_for_local
# LLM_PROVIDER=custom
# LLM_API_BASE=http://localhost:11434
# CEREBRAS_MODEL=your_local_model

# Dashboard Model Selection:
# The dashboard dynamically fetches available models from your configured provider's API.
# If the API call fails, it falls back to provider-specific defaults for robustness.
