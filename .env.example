# ENTSO-E API Configuration (optional: without a key, sample prices from data/prices_sample.json are used)
# ENTSOE_API_KEY=your_entsoe_api_key_here
BIDDING_ZONE=AT

# Which LLM provider to use: cerebras (default, the base paper's) | groq | openrouter | ollama
# Each provider reads its own <PROVIDER>_API_KEY and <PROVIDER>_MODEL below, so several can be
# filled in at once; `python -m b2g.cli --provider <name>` switches for one run.
# Any other OpenAI-compatible server: set LLM_BASE_URL (ending in /v1), LLM_API_KEY, LLM_MODEL.
LLM_PROVIDER=cerebras

# Cerebras
CEREBRAS_API_KEY=your_cerebras_api_key_here
# CEREBRAS_MODEL=llama-3.1-8b

# Groq (free tier, no card)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter (free account, no card)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=model_id_from_openrouter

# Ollama (local, no key): run `ollama serve` first
# OLLAMA_MODEL=llama3.1:8b

# LLM response cache in results/cache/: on (default) | off | refresh
# LLM_CACHE=on
